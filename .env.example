# 办公文档转换器 —— 环境变量模板
#
# 用法：把本文件复制为 .env（同一目录），填入自己的密钥后重启服务。
#   Copy-Item .env.example .env
#
# 只有「文献翻译」功能需要 API 密钥，其它转换/压缩/PDF 工具都不受影响。
# 已经存在的真实环境变量优先级高于 .env 文件。
#
# 注意：main.py 优先用 python-dotenv 读取 .env；没安装时用内置的极简解析器兜底，
# 因此「复制为 .env 填密钥」的用法不需要额外安装任何依赖。
# 已经存在的真实环境变量优先级最高，例如：
#   $env:TRANSLATE_API_KEY = "sk-xxxx"

# ---------- 文献翻译（必填三项） ----------

# API 密钥。兼容 OpenAI 的 /chat/completions 接口
TRANSLATE_API_KEY=

# 接口地址（OpenAI 兼容）。默认 DeepSeek；
# 用 OpenAI 就填 https://api.openai.com/v1，通义/智谱等填各自兼容地址。
TRANSLATE_BASE_URL=https://api.deepseek.com/v1

# 模型名：DeepSeek 用 deepseek-chat；OpenAI 用 gpt-4o-mini 等
TRANSLATE_MODEL=deepseek-chat

# ---------- 文献翻译（可选，均为 translator.py 的默认值） ----------

# 目标语言，默认简体中文
# TRANSLATE_TARGET_LANG=简体中文

# 采样温度，翻译建议 1.0 ~ 1.3
# TRANSLATE_TEMPERATURE=1.0

# 单次请求携带的原文长度上限（字符）。调小可降低单次超时风险
# TRANSLATE_MAX_CHARS=3500

# 单次请求超时秒数
# TRANSLATE_TIMEOUT=180

# 是否默认跳过参考文献（1 跳过 / 0 不跳过）
# TRANSLATE_SKIP_REFERENCES=1

# 翻译并发线程数，默认 1（调大会更快，也更容易触发接口限流）
# TRANSLATE_WORKERS=1

# ---------- 上传大小限制（可选，由 main.py 读取，必须是大于 0 的整数，单位 MB） ----------

# 单个上传文件上限，默认 200
# MAX_FILE_SIZE_MB=200

# 批量上传总大小上限，默认 500
# MAX_BATCH_SIZE_MB=500

# ---------- Office COM 转换超时（可选，由 converter.py 读取，必须是大于 0 的整数，单位秒） ----------

# 单次 Office 转换超时，默认 900；超时会中止本次转换并清理新起的 Office 进程
# OFFICE_TIMEOUT_SECONDS=900

# 首次 Office 健康探测的超时，默认 45
# OFFICE_PROBE_TIMEOUT_SECONDS=45

# 探测失败后隔多久允许再探测一次，默认 600
# OFFICE_RECHECK_SECONDS=600
